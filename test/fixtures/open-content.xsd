<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Open-content fixture.

  Exercises XSD 1.1 §3.4 (xs:openContent) and §3.16.2.2 (xs:defaultOpenContent).
  Scenarios:
    Doc      — own openContent mode="suffix" overrides default
    Article  — inherits the schema-level defaultOpenContent (interleave)
    Manifest — opts out of the default with mode="none"
    Note     — derived from Doc; inherits its open content
-->
<xs:schema
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  targetNamespace="urn:xsdstyle:test:open-content"
  xmlns="urn:xsdstyle:test:open-content"
  elementFormDefault="qualified">
  <xs:annotation>
    <xs:documentation>
      Test schema for XSD 1.1 open content. The schema-level
      xs:defaultOpenContent applies a "##other" wildcard in interleave
      mode to every complex type with complex content, unless the type
      declares its own openContent.
    </xs:documentation>
  </xs:annotation>

  <xs:defaultOpenContent mode="interleave" appliesToEmpty="false">
    <xs:any namespace="##other" processContents="lax" />
  </xs:defaultOpenContent>

  <xs:element name="doc" type="Doc" />
  <xs:element name="article" type="Article" />
  <xs:element name="manifest" type="Manifest" />
  <xs:element name="note" type="Note" />

  <!--
    Own openContent in suffix mode. Should override the
    schema-level defaultOpenContent.
  -->
  <xs:complexType name="Doc">
    <xs:openContent mode="suffix">
      <xs:any namespace="##local" processContents="lax" />
    </xs:openContent>
    <xs:sequence>
      <xs:element name="title" type="xs:string" />
    </xs:sequence>
  </xs:complexType>

  <!--
    No own openContent. Schema-level defaultOpenContent applies
    (interleave mode, ##other wildcard).
  -->
  <xs:complexType name="Article">
    <xs:sequence>
      <xs:element name="heading" type="xs:string" />
      <xs:element name="body" type="xs:string" minOccurs="0" />
    </xs:sequence>
  </xs:complexType>

  <!--
    Opt-out: explicit mode="none" suppresses the inherited
    defaultOpenContent.
  -->
  <xs:complexType name="Manifest">
    <xs:openContent mode="none" />
    <xs:sequence>
      <xs:element name="entry" type="xs:string" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <!--
    Derives from Doc via complex-content extension. The renderer should
    show Doc's open content (suffix ##local wildcard) inherited here.
  -->
  <xs:complexType name="Note">
    <xs:complexContent>
      <xs:extension base="Doc">
        <xs:sequence>
          <xs:element name="addendum" type="xs:string" />
        </xs:sequence>
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
</xs:schema>
