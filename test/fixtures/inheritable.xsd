<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Inheritable attributes fixture.

  Exercises XSD 1.1 §3.2.2 (@inheritable on xs:attribute) and §3.4.4.3
  (inheritable attributes are in the test context of xs:alternative).

  Scenarios:
    SectionType  — declares @lang as inheritable.
    Paragraph    — element using a derived type chain. The CTA element
                   inside should see @lang in the test context.
-->
<xs:schema
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  targetNamespace="urn:xsdstyle:test:inheritable"
  xmlns="urn:xsdstyle:test:inheritable"
  elementFormDefault="qualified">
  <xs:element name="section">
    <xs:complexType>
      <xs:complexContent>
        <xs:extension base="SectionType">
          <xs:sequence>
            <xs:element name="paragraph">
              <xs:alternative test="@lang = 'en'" type="EnglishParagraph" />
              <xs:alternative test="@lang = 'fr'" type="FrenchParagraph" />
              <xs:alternative type="GenericParagraph" />
            </xs:element>
          </xs:sequence>
        </xs:extension>
      </xs:complexContent>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="SectionType">
    <xs:sequence>
      <xs:element name="title" type="xs:string" />
    </xs:sequence>
    <!-- Inheritable: visible to xs:alternative/@test in descendant elements. -->
    <xs:attribute name="lang" type="xs:language" inheritable="true" />
    <!-- Not inheritable; control case for the renderer. -->
    <xs:attribute name="id" type="xs:ID" />
  </xs:complexType>

  <xs:complexType name="ParagraphBase" abstract="true">
    <xs:sequence>
      <xs:element name="body" type="xs:string" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="EnglishParagraph">
    <xs:complexContent>
      <xs:extension base="ParagraphBase">
        <xs:attribute name="locale" type="xs:string" fixed="en-US" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="FrenchParagraph">
    <xs:complexContent>
      <xs:extension base="ParagraphBase">
        <xs:attribute name="locale" type="xs:string" fixed="fr-FR" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>

  <xs:complexType name="GenericParagraph">
    <xs:complexContent>
      <xs:extension base="ParagraphBase">
        <xs:attribute name="locale" type="xs:string" />
      </xs:extension>
    </xs:complexContent>
  </xs:complexType>
</xs:schema>
