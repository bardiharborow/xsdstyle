<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Internationalisation integration contract. The f:t() key lookup, the
  exact -> primary-subtag -> en chain, and the [[key]] missing-key sentinel are
  unit-tested in helpers.xspec. These scenarios assert that generated chrome is
  actually wired through the catalog, that an unknown or regional interface
  language falls back to English chrome without leaking the [[key]] sentinel,
  and that the runtime JSON block is catalog-sourced.

  Run via `make test` or `make test XSPEC_TESTS=test/i18n.xspec`.
-->
<x:description
  xmlns:x="http://www.jenitennison.com/xslt/xspec"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  stylesheet="../xsdstyle.xsl"
  run-as="external">
  <x:scenario label="interface chrome flows through the message catalog">
    <x:context>
      <xs:schema targetNamespace="urn:example">
        <xs:element name="Foo" type="xs:string" />
      </xs:schema>
    </x:context>

    <x:scenario label="default English chrome is catalog-sourced">
      <x:expect
        label="known chrome strings render their English catalog values"
        test="normalize-space($x:result//a[@class eq 'skip-link']) eq 'Skip to main content'
          and $x:result//nav[@class eq 'sidebar']/@aria-label eq 'Components'
          and normalize-space($x:result//footer[@class eq 'colophon']//p) eq 'Generated by xsdstyle v0.1.0-dev.'
          and $x:result//footer[@class eq 'colophon']//p/a eq 'xsdstyle'" />
    </x:scenario>

    <x:scenario label="no missing-key sentinel leaks into default output">
      <x:expect label="output contains no [[key]] markers" test="not(contains(string($x:result), '[['))" />
    </x:scenario>

    <x:scenario label="a regional language resolves via its primary subtag">
      <x:param name="interface-language" select="'en-GB'" />
      <x:expect
        label="html lang is preserved while chrome stays English with no sentinels"
        test="$x:result/@lang eq 'en-GB'
          and normalize-space($x:result//a[@class eq 'skip-link']) eq 'Skip to main content'
          and not(contains(string($x:result), '[['))" />
    </x:scenario>

    <x:scenario label="an unknown language falls back to English chrome">
      <x:param name="interface-language" select="'zxx'" />
      <x:expect
        label="chrome falls back to English without leaking sentinels"
        test="$x:result/@lang eq 'zxx'
          and normalize-space($x:result//nav[@class eq 'sidebar']/@aria-label) eq 'Components'
          and not(contains(string($x:result), '[['))" />
    </x:scenario>

    <x:scenario label="schema rows, attribute tables, and diagnostics are catalog-sourced">
      <x:context>
        <xs:schema
          xmlns:xs="http://www.w3.org/2001/XMLSchema"
          xmlns:tns="urn:example"
          xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning"
          targetNamespace="urn:example">
          <xs:include schemaLocation="missing.xsd" />
          <xs:element name="Broken" type="Missing" vc:minVersion="1.1" />
          <xs:complexType name="Holder">
            <xs:sequence />
            <xs:attribute name="code" type="xs:string" default="A" inheritable="true" />
            <xs:anyAttribute namespace="##any" processContents="lax" />
          </xs:complexType>
        </xs:schema>
      </x:context>
      <x:expect
        label="wide chrome coverage renders English catalog values with no sentinels"
        test="not(contains(string($x:result), '[['))
          and normalize-space($x:result//div[@id eq 'schema-edge-1']//span[@class eq 'schema-row__status']) eq 'not loaded'
          and starts-with(normalize-space($x:result//div[@class eq 'schema-row'][@data-document-id]/span[@class eq 'schema-row__declared-ns']), 'declared:')
          and exists($x:result//section[@id eq 'diagnostics']//li[@data-code eq 'qname-unresolved']//p[@class eq 'diagnostic__context'][starts-with(normalize-space(.), 'Attribute')])" />
    </x:scenario>

    <x:scenario label="the runtime JSON block is catalog-sourced">
      <x:expect
        label="the xsdoc-i18n script carries the catalog filter-results string"
        test="exists($x:result//script[@id eq 'xsdoc-i18n'])
          and contains(string($x:result//script[@id eq 'xsdoc-i18n']), 'components shown')
          and contains(string($x:result//script[@id eq 'xsdoc-i18n']), 'Link copied')" />
    </x:scenario>
  </x:scenario>
</x:description>
