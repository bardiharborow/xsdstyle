<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Unit tests for xsdstyle.xsl helper functions.

  This file is the contract for the pure (non-schema-aware) helper functions
  in Region 6 of the stylesheet. Integration verification of schema-aware
  rendering (open content, inheritable attributes, vc:* attributes) is
  driven by `make render-smoke`, which renders each fixture and greps for
  expected BEM classes.

  Run via `make test` from the repository root.
-->
<x:description
  xmlns:x="http://www.jenitennison.com/xslt/xspec"
  xmlns:f="urn:xsdoc:functions"
  xmlns:xs="http://www.w3.org/2001/XMLSchema"
  xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning"
  stylesheet="../xsdstyle.xsl">
  <!-- ===== x:clark — QName to Clark form ===== -->
  <x:scenario label="x:clark">
    <x:scenario label="qualified QName renders Clark notation">
      <x:call function="f:clark">
        <x:param select="QName('urn:example', 'foo')" />
      </x:call>
      <x:expect label="namespace in braces, then local name" select="'{urn:example}foo'" />
    </x:scenario>

    <x:scenario label="no-namespace QName renders empty braces">
      <x:call function="f:clark">
        <x:param select="QName('', 'bare')" />
      </x:call>
      <x:expect label="empty namespace still emits braces" select="'{}bare'" />
    </x:scenario>

    <x:scenario label="empty input returns empty string">
      <x:call function="f:clark">
        <x:param select="()" />
      </x:call>
      <x:expect label="empty string" select="''" />
    </x:scenario>
  </x:scenario>

  <!-- ===== x:occurs — minOccurs/maxOccurs marker ===== -->
  <x:scenario label="x:occurs">
    <x:scenario label="default 1..1 produces no marker">
      <x:call function="f:occurs">
        <x:param>
          <element />
        </x:param>
      </x:call>
      <x:expect label="empty string" select="''" />
    </x:scenario>

    <x:scenario label="0..1 produces ?">
      <x:call function="f:occurs">
        <x:param>
          <element minOccurs="0" maxOccurs="1" />
        </x:param>
      </x:call>
      <x:expect label="question mark" select="'?'" />
    </x:scenario>

    <x:scenario label="0..unbounded produces *">
      <x:call function="f:occurs">
        <x:param>
          <element minOccurs="0" maxOccurs="unbounded" />
        </x:param>
      </x:call>
      <x:expect label="star" select="'*'" />
    </x:scenario>

    <x:scenario label="1..unbounded produces +">
      <x:call function="f:occurs">
        <x:param>
          <element minOccurs="1" maxOccurs="unbounded" />
        </x:param>
      </x:call>
      <x:expect label="plus" select="'+'" />
    </x:scenario>

    <x:scenario label="explicit 1..1 produces no marker">
      <x:call function="f:occurs">
        <x:param>
          <element minOccurs="1" maxOccurs="1" />
        </x:param>
      </x:call>
      <x:expect label="empty string" select="''" />
    </x:scenario>

    <x:scenario label="bounded range falls through to [min..max]">
      <x:call function="f:occurs">
        <x:param>
          <element minOccurs="2" maxOccurs="5" />
        </x:param>
      </x:call>
      <x:expect label="bracketed range" select="'[2..5]'" />
    </x:scenario>

    <x:scenario label="exact N..N produces [N..N]">
      <x:call function="f:occurs">
        <x:param>
          <element minOccurs="3" maxOccurs="3" />
        </x:param>
      </x:call>
      <x:expect label="bracketed equal range" select="'[3..3]'" />
    </x:scenario>

    <x:scenario label="all with maxOccurs > 1 (XSD 1.1) produces a bounded marker">
      <x:call function="f:occurs">
        <x:param>
          <element minOccurs="1" maxOccurs="3" />
        </x:param>
      </x:call>
      <x:expect label="XSD 1.1 all-group bound" select="'[1..3]'" />
    </x:scenario>
  </x:scenario>

  <!-- ===== x:occurs-title — human-readable tooltip ===== -->
  <x:scenario label="x:occurs-title">
    <x:scenario label="default 1..1 produces no title">
      <x:call function="f:occurs-title">
        <x:param>
          <element />
        </x:param>
      </x:call>
      <x:expect label="empty string" select="''" />
    </x:scenario>

    <x:scenario label="0..1 produces an Optional title">
      <x:call function="f:occurs-title">
        <x:param>
          <element minOccurs="0" maxOccurs="1" />
        </x:param>
      </x:call>
      <x:expect label="optional" select="'Optional: 0 or 1 occurrence (minOccurs=0, maxOccurs=1)'" />
    </x:scenario>

    <x:scenario label="0..unbounded produces zero-or-more">
      <x:call function="f:occurs-title">
        <x:param>
          <element minOccurs="0" maxOccurs="unbounded" />
        </x:param>
      </x:call>
      <x:expect label="zero or more" select="'Zero or more occurrences (minOccurs=0, maxOccurs=unbounded)'" />
    </x:scenario>

    <x:scenario label="1..unbounded produces one-or-more">
      <x:call function="f:occurs-title">
        <x:param>
          <element minOccurs="1" maxOccurs="unbounded" />
        </x:param>
      </x:call>
      <x:expect label="one or more" select="'One or more occurrences (minOccurs=1, maxOccurs=unbounded)'" />
    </x:scenario>

    <x:scenario label="exact N..N produces Exactly N">
      <x:call function="f:occurs-title">
        <x:param>
          <element minOccurs="3" maxOccurs="3" />
        </x:param>
      </x:call>
      <x:expect label="exactly 3" select="'Exactly 3 occurrences (minOccurs=3, maxOccurs=3)'" />
    </x:scenario>
  </x:scenario>

  <!-- ===== x:xsd-true — boolean-literal parsing ===== -->
  <x:scenario label="x:xsd-true">
    <x:scenario label="empty sequence is false">
      <x:call function="f:xsd-true">
        <x:param select="()" />
      </x:call>
      <x:expect label="false" select="false()" />
    </x:scenario>

    <x:scenario label="'true' is true">
      <x:call function="f:xsd-true">
        <x:param select="'true'" />
      </x:call>
      <x:expect label="true" select="true()" />
    </x:scenario>

    <x:scenario label="'1' is true">
      <x:call function="f:xsd-true">
        <x:param select="'1'" />
      </x:call>
      <x:expect label="true" select="true()" />
    </x:scenario>

    <x:scenario label="'false' is false">
      <x:call function="f:xsd-true">
        <x:param select="'false'" />
      </x:call>
      <x:expect label="false" select="false()" />
    </x:scenario>

    <x:scenario label="'0' is false">
      <x:call function="f:xsd-true">
        <x:param select="'0'" />
      </x:call>
      <x:expect label="false" select="false()" />
    </x:scenario>

    <x:scenario label="garbage is false">
      <x:call function="f:xsd-true">
        <x:param select="'yes'" />
      </x:call>
      <x:expect label="false" select="false()" />
    </x:scenario>
  </x:scenario>

  <!-- ===== x:is-overridden — detects xs:override containment ===== -->
  <x:scenario label="x:is-overridden">
    <x:scenario label="component inside xs:override is overridden">
      <x:variable name="ov" as="element()">
        <override xmlns="http://www.w3.org/2001/XMLSchema">
          <complexType name="T" />
        </override>
      </x:variable>
      <x:call function="f:is-overridden">
        <x:param select="$ov/*[1]" />
      </x:call>
      <x:expect label="true" select="true()" />
    </x:scenario>

    <x:scenario label="top-level component is not overridden">
      <x:call function="f:is-overridden">
        <x:param>
          <complexType xmlns="http://www.w3.org/2001/XMLSchema" name="T" />
        </x:param>
      </x:call>
      <x:expect label="false" select="false()" />
    </x:scenario>
  </x:scenario>

  <!-- ===== x:is-redefined — detects xs:redefine containment ===== -->
  <x:scenario label="x:is-redefined">
    <x:scenario label="component inside xs:redefine is redefined">
      <x:variable name="rd" as="element()">
        <redefine xmlns="http://www.w3.org/2001/XMLSchema">
          <complexType name="T" />
        </redefine>
      </x:variable>
      <x:call function="f:is-redefined">
        <x:param select="$rd/*[1]" />
      </x:call>
      <x:expect label="true" select="true()" />
    </x:scenario>

    <x:scenario label="top-level component is not redefined">
      <x:call function="f:is-redefined">
        <x:param>
          <complexType xmlns="http://www.w3.org/2001/XMLSchema" name="T" />
        </x:param>
      </x:call>
      <x:expect label="false" select="false()" />
    </x:scenario>
  </x:scenario>

  <!-- ===== x:format-notQName — XSD 1.1 wildcard token rendering ===== -->
  <x:scenario label="x:format-notQName">
    <x:scenario label="##defined token renders as wildcard-token code">
      <x:call function="f:format-notQName">
        <x:param select="'##defined'" />
        <x:param select="'element'" />
        <x:param>
          <any xmlns="http://www.w3.org/2001/XMLSchema" />
        </x:param>
      </x:call>
      <x:expect label="##defined code element">
        <code class="wildcard-token">##defined</code>
      </x:expect>
    </x:scenario>

    <x:scenario label="##definedSibling token renders as wildcard-token code">
      <x:call function="f:format-notQName">
        <x:param select="'##definedSibling'" />
        <x:param select="'element'" />
        <x:param>
          <any xmlns="http://www.w3.org/2001/XMLSchema" />
        </x:param>
      </x:call>
      <x:expect label="##definedSibling code element">
        <code class="wildcard-token">##definedSibling</code>
      </x:expect>
    </x:scenario>

    <x:scenario label="empty string produces no output">
      <x:call function="f:format-notQName">
        <x:param select="''" />
        <x:param select="'element'" />
        <x:param>
          <any xmlns="http://www.w3.org/2001/XMLSchema" />
        </x:param>
      </x:call>
      <x:expect label="empty sequence" select="()" />
    </x:scenario>
  </x:scenario>

  <!-- ===== x:safe-href — URL sanitiser ===== -->
  <x:scenario label="x:safe-href">
    <x:scenario label="ordinary https URL passes through">
      <x:call function="f:safe-href">
        <x:param select="'https://example.com/path'" />
      </x:call>
      <x:expect label="unchanged" select="'https://example.com/path'" />
    </x:scenario>

    <x:scenario label="ordinary http URL passes through">
      <x:call function="f:safe-href">
        <x:param select="'http://example.com/'" />
      </x:call>
      <x:expect label="unchanged" select="'http://example.com/'" />
    </x:scenario>

    <x:scenario label="mailto: passes through">
      <x:call function="f:safe-href">
        <x:param select="'mailto:hello@example.com'" />
      </x:call>
      <x:expect label="unchanged" select="'mailto:hello@example.com'" />
    </x:scenario>

    <x:scenario label="same-document fragment passes through">
      <x:call function="f:safe-href">
        <x:param select="'#anchor'" />
      </x:call>
      <x:expect label="unchanged" select="'#anchor'" />
    </x:scenario>

    <x:scenario label="relative path passes through">
      <x:call function="f:safe-href">
        <x:param select="'./local.html'" />
      </x:call>
      <x:expect label="unchanged" select="'./local.html'" />
    </x:scenario>

    <x:scenario label="javascript: scheme is rejected">
      <x:call function="f:safe-href">
        <x:param select="'javascript:alert(1)'" />
      </x:call>
      <x:expect label="empty sequence" select="()" />
    </x:scenario>

    <x:scenario label="case + whitespace bypass is rejected">
      <x:call function="f:safe-href">
        <x:param select="'  JAVASCRIPT:alert(1)'" />
      </x:call>
      <x:expect label="empty sequence" select="()" />
    </x:scenario>

    <x:scenario label="data: scheme is rejected">
      <x:call function="f:safe-href">
        <x:param select="'data:text/html,&lt;script&gt;'" />
      </x:call>
      <x:expect label="empty sequence" select="()" />
    </x:scenario>

    <x:scenario label="vbscript: scheme is rejected">
      <x:call function="f:safe-href">
        <x:param select="'vbscript:msgbox(1)'" />
      </x:call>
      <x:expect label="empty sequence" select="()" />
    </x:scenario>

    <x:scenario label="file: scheme is rejected">
      <x:call function="f:safe-href">
        <x:param select="'file:///etc/passwd'" />
      </x:call>
      <x:expect label="empty sequence" select="()" />
    </x:scenario>
  </x:scenario>

  <!-- ===== x:vc-attrs — collect vc:* attributes from an element ===== -->
  <x:scenario label="x:vc-attrs">
    <x:scenario label="element with no vc:* attrs returns empty">
      <x:call function="f:vc-attrs">
        <x:param>
          <element xmlns="http://www.w3.org/2001/XMLSchema" name="X" />
        </x:param>
      </x:call>
      <x:expect label="empty sequence" select="()" />
    </x:scenario>

    <x:scenario label="vc:minVersion is returned">
      <x:variable name="el" as="element()">
        <element
          xmlns="http://www.w3.org/2001/XMLSchema"
          xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning"
          name="X"
          vc:minVersion="1.1" />
      </x:variable>
      <x:call function="f:vc-attrs">
        <x:param select="$el" />
      </x:call>
      <x:expect
        label="one attribute returned"
        test="count($x:result) eq 1
        and node-name(($x:result)[1]) eq QName('http://www.w3.org/2007/XMLSchema-versioning', 'vc:minVersion')
        and string(($x:result)[1]) eq '1.1'" />
    </x:scenario>

    <x:scenario label="multiple vc:* attributes are all returned">
      <x:variable name="el" as="element()">
        <element
          xmlns="http://www.w3.org/2001/XMLSchema"
          xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning"
          name="X"
          vc:minVersion="1.1"
          vc:maxVersion="2.0" />
      </x:variable>
      <x:call function="f:vc-attrs">
        <x:param select="$el" />
      </x:call>
      <x:expect label="two attributes returned" test="count($x:result) eq 2" />
    </x:scenario>

    <x:scenario label="non-vc attributes are not returned">
      <x:variable name="el" as="element()">
        <element
          xmlns="http://www.w3.org/2001/XMLSchema"
          xmlns:vc="http://www.w3.org/2007/XMLSchema-versioning"
          name="X"
          vc:minVersion="1.1"
          id="foo" />
      </x:variable>
      <x:call function="f:vc-attrs">
        <x:param select="$el" />
      </x:call>
      <x:expect
        label="only the vc attribute"
        test="count($x:result) eq 1
        and namespace-uri(($x:result)[1]) eq 'http://www.w3.org/2007/XMLSchema-versioning'" />
    </x:scenario>
  </x:scenario>

  <!-- ===== x:abbr — kind to short abbreviation ===== -->
  <x:scenario label="x:abbr">
    <x:scenario label="element kind abbreviates to el">
      <x:call function="f:abbr">
        <x:param select="'element'" />
      </x:call>
      <x:expect label="el" select="'el'" />
    </x:scenario>

    <x:scenario label="complexType kind abbreviates to ct">
      <x:call function="f:abbr">
        <x:param select="'complexType'" />
      </x:call>
      <x:expect label="ct" select="'ct'" />
    </x:scenario>

    <x:scenario label="simpleType kind abbreviates to st">
      <x:call function="f:abbr">
        <x:param select="'simpleType'" />
      </x:call>
      <x:expect label="st" select="'st'" />
    </x:scenario>

    <x:scenario label="attribute kind abbreviates to at">
      <x:call function="f:abbr">
        <x:param select="'attribute'" />
      </x:call>
      <x:expect label="at" select="'at'" />
    </x:scenario>

    <x:scenario label="attributeGroup kind abbreviates to ag">
      <x:call function="f:abbr">
        <x:param select="'attributeGroup'" />
      </x:call>
      <x:expect label="ag" select="'ag'" />
    </x:scenario>

    <x:scenario label="group kind abbreviates to gr">
      <x:call function="f:abbr">
        <x:param select="'group'" />
      </x:call>
      <x:expect label="gr" select="'gr'" />
    </x:scenario>

    <x:scenario label="notation kind abbreviates to no">
      <x:call function="f:abbr">
        <x:param select="'notation'" />
      </x:call>
      <x:expect label="no" select="'no'" />
    </x:scenario>
  </x:scenario>

  <!-- ===== x:is-xs — Clark/QName is in XSD namespace ===== -->
  <x:scenario label="x:is-xs">
    <x:scenario label="XSD-namespace QName is recognised">
      <x:call function="f:is-xs">
        <x:param select="QName('http://www.w3.org/2001/XMLSchema', 'string')" />
      </x:call>
      <x:expect label="true" select="true()" />
    </x:scenario>

    <x:scenario label="custom-namespace QName is not XSD">
      <x:call function="f:is-xs">
        <x:param select="QName('urn:example', 'Foo')" />
      </x:call>
      <x:expect label="false" select="false()" />
    </x:scenario>

    <x:scenario label="empty input is not XSD">
      <x:call function="f:is-xs">
        <x:param select="()" />
      </x:call>
      <x:expect label="false" select="false()" />
    </x:scenario>
  </x:scenario>

  <!-- ===== x:anchor — assemble {abbr}-{nsid}-{name} anchor ===== -->
  <x:scenario label="x:anchor">
    <x:scenario label="primary namespace produces empty ns segment">
      <x:call function="f:anchor">
        <x:param select="'element'" />
        <x:param select="''" />
        <x:param select="'Foo'" />
      </x:call>
      <x:expect label="el-Foo" select="'el-Foo'" />
    </x:scenario>

    <x:scenario label="secondary namespace inserts nsid">
      <x:call function="f:anchor">
        <x:param select="'complexType'" />
        <x:param select="'ns1'" />
        <x:param select="'Bar'" />
      </x:call>
      <x:expect label="ct-ns1-Bar" select="'ct-ns1-Bar'" />
    </x:scenario>
  </x:scenario>

  <!-- ===== x:t / x:format-message — i18n lookup and placeholder substitution ===== -->
  <x:scenario label="x:t (default locale = en)">
    <x:scenario label="exact-match key returns the en value">
      <x:call function="f:t">
        <x:param select="'sidebar.filter'" />
      </x:call>
      <x:expect label="Filter" select="'Filter'" />
    </x:scenario>

    <x:scenario label="missing key returns [[key]] sentinel">
      <x:call function="f:t">
        <x:param select="'no.such.key'" />
      </x:call>
      <x:expect label="bracket-sentinel" select="'[[no.such.key]]'" />
    </x:scenario>

    <x:scenario label="parameterised key substitutes named placeholders">
      <x:call function="f:t">
        <x:param select="'occurs.between'" />
        <x:param select="map { 'min': '2', 'max': '5' }" />
      </x:call>
      <x:expect label="substituted occurs.between" select="'Between 2 and 5 occurrences (minOccurs=2, maxOccurs=5)'" />
    </x:scenario>

    <x:scenario label="repeated placeholder substitutes every occurrence">
      <x:call function="f:format-message">
        <x:param select="'{a}-{a}-{b}'" />
        <x:param select="map { 'a': 'x', 'b': 'y' }" />
      </x:call>
      <x:expect label="x-x-y" select="'x-x-y'" />
    </x:scenario>

    <x:scenario label="empty params leaves template untouched">
      <x:call function="f:format-message">
        <x:param select="'no placeholders here'" />
        <x:param select="map {}" />
      </x:call>
      <x:expect label="passthrough" select="'no placeholders here'" />
    </x:scenario>
  </x:scenario>

  <!-- Locale-fallback resolution (fr-CA → fr → en, empty → en) is covered
       end-to-end by `make render-smoke`, which renders the fixture with
       a non-en ui-lang and greps for the English chrome. The ui-lang vs
       xml-lang split (chrome catalog driven by ui-lang; doc wrappers get
       lang= falling back to xml-lang) is also exercised there. Scenario-
       scoped stylesheet-parameter overrides require XSpec @run-as='external',
       which we don't enable for the rest of the suite. -->
</x:description>
