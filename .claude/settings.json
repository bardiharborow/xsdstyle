{
  "permissions": {
    "deny": [
      "Edit(out/**)",
      "Write(out/**)",
      "Edit(.tools/**)",
      "Write(.tools/**)",
      "Edit(test/xspec/**)",
      "Write(test/xspec/**)",
      "Edit(specifications/**)",
      "Write(specifications/**)",
      "Edit(reference/**)",
      "Write(reference/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/post-edit.sh",
            "timeout": 240
          }
        ]
      }
    ]
  }
}
